rules_version = '2';
// Driver documents: each driver uploads only into their own folder.
// Photos must be images under 8 MB. Admins read them from the Admin panel
// using the download links saved in drivers/{uid}.documents.
service firebase.storage {
  match /b/{bucket}/o {
    match /drivers/{driverId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == driverId;
      allow write: if request.auth != null
        && request.auth.uid == driverId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
